##############################################################
# ReachInbox Email Scheduler — Backend Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file to version control.
##############################################################

PORT=5000

# PostgreSQL (Docker default — change for production)
DATABASE_URL="postgresql://postgres:your_postgres_password@localhost:5432/reachinbox?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200

# Worker configuration
WORKER_CONCURRENCY=5
MIN_EMAIL_DELAY_MS=2000
MAX_EMAILS_PER_HOUR=200

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback

# Slack OAuth — https://api.slack.com/apps -> Basic Information
# Required scopes: chat:write, channels:read, chat:write.public
# Redirect URL: http://localhost:5000/auth/slack/callback
SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret
SLACK_REDIRECT_URI=http://localhost:5000/auth/slack/callback

# JWT — generate with: openssl rand -hex 32
JWT_SECRET=replace_with_a_strong_random_secret

# Ethereal SMTP — leave blank to auto-create a test account on startup
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_USER=
ETHEREAL_PASSWORD=

# Frontend URL
FRONTEND_URL=http://localhost:5173
